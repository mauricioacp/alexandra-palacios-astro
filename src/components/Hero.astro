---
import { Award, Users, Clock } from 'lucide-astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-image-new.jpeg';
---

<section id="inicio" class="pt-20 pb-16 bg-primary-50 dark:bg-surface-dark">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Content -->
      <div class="space-y-8" data-reveal="animate-fade-in animate-slide-in-from-bottom-4 animate-duration-700">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-primary-100 dark:bg-primary-500/10 ring-1 ring-primary-200 dark:ring-primary-500/20 text-primary-700 dark:text-primary-300">
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span class="absolute inline-flex h-full w-full rounded-full bg-primary-500 opacity-75 animate-ping"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-primary-600 dark:bg-primary-400"></span>
            </span>
            <span class="text-sm font-medium tracking-wide">Terapia Clínica Oral para estar en equilibrio</span>
          </div>
          <h1 class="text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white leading-tight">
            Transformando la
            <span class="text-primary-600 dark:text-primary-400"> comunicación</span> de adultos y niños
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-300 leading-relaxed">
            Con más de 17 años de experiencia clínica, especializada en terapia miofuncional y rehabilitación del habla en Segovia.
          </p>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-6">
          <div class="text-center">
            <div class="flex items-center justify-center w-12 h-12 bg-primary-100 dark:bg-primary-900/30 rounded-full mx-auto mb-2">
              <Clock class="w-6 h-6 text-primary-600 dark:text-primary-400" />
            </div>
            <div class="text-2xl font-bold text-gray-900 dark:text-white">17+</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Años de experiencia</div>
          </div>
          <div class="text-center">
            <div class="flex items-center justify-center w-12 h-12 bg-blue-100 dark:bg-blue-900/30 rounded-full mx-auto mb-2">
              <Users class="w-6 h-6 text-blue-600 dark:text-blue-400" />
            </div>
            <div class="text-2xl font-bold text-gray-900 dark:text-white">500+</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Pacientes tratados</div>
          </div>
          <div class="text-center">
            <div class="flex items-center justify-center w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-full mx-auto mb-2">
              <Award class="w-6 h-6 text-green-600 dark:text-green-400" />
            </div>
            <div class="text-2xl font-bold text-gray-900 dark:text-white">95%</div>
            <div class="text-sm text-gray-600 dark:text-gray-400">Éxito en tratamientos</div>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="https://wa.me/34614417513?text=Hola%20Alexandra,%20me%20gustaría%20reservar%20una%20consulta"
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="whatsapp-hero-reservar"
            class="inline-flex items-center justify-center px-8 py-4 bg-primary-600 text-white font-semibold rounded-full hover:bg-primary-700 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1"
          >
            Reservar Consulta Ahora
          </a>
          <button
            data-scroll-to="sobre-mi"
            class="inline-flex items-center justify-center px-8 py-4 border-2 border-primary-600 dark:border-primary-400 text-primary-600 dark:text-primary-400 font-semibold rounded-full hover:bg-primary-600 hover:text-white dark:hover:bg-primary-400 dark:hover:text-surface-dark transition-all duration-300 transform hover:-translate-y-0.5"
          >
            Conocer Más
          </button>
        </div>
      </div>

      <!-- Image -->
      <div class="relative" data-reveal="animate-fade-in animate-slide-in-from-bottom-4 animate-duration-700 animate-delay-200">
        <div class="relative z-10">
          <Image
            src={heroImage}
            alt="Alexandra Palacios - Logopeda especialista en Segovia"
            class="w-full max-w-md mx-auto rounded-2xl shadow-2xl"
            loading="eager"
            width={400}
            height={600}
            format="webp"
            quality="high"
          />
        </div>
        <!-- Decorative elements -->
        <div class="absolute -top-4 -right-4 w-24 h-24 bg-primary-300/20 dark:bg-primary-700/20 rounded-full animate-pulse"></div>
        <div class="absolute -bottom-4 -left-4 w-32 h-32 bg-primary-300/20 dark:bg-primary-700/20 rounded-full animate-pulse delay-1000"></div>
      </div>
    </div>
  </div>
</section>

<script>
  function initializeHeroButtons() {
    const scrollButtons = document.querySelectorAll('[data-scroll-to]');
    scrollButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const target = (e.currentTarget as HTMLElement).getAttribute('data-scroll-to');
        if (target) {
          const element = document.getElementById(target);
          if (element) {
            element.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeHeroButtons);
  } else {
    initializeHeroButtons();
  }
  document.addEventListener('astro:page-load', initializeHeroButtons);
</script>
