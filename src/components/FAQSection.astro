---
import FAQ from '@/components/FAQ.astro';
import { ChevronRight } from 'lucide-astro';

interface Props {
  limit?: number;
}

const { limit = 6 } = Astro.props;
---

<section id="faq" class="py-20 bg-white dark:bg-surface-dark">
  <div class="container mx-auto px-4">
    <div class="text-center mb-4">
      <h2 class="text-3xl md:text-4xl font-bold text-primary-600 dark:text-primary-400 mb-4">
        Preguntas Frecuentes
      </h2>
      <p class="text-lg text-gray-700 dark:text-gray-300 max-w-2xl mx-auto">
        Resuelve tus dudas sobre logopedia y nuestros servicios
      </p>
    </div>

    <FAQ limit={limit} />

    <div class="text-center mt-10">
      <a
        href="/preguntas-frecuentes/"
        class="group inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-semibold text-lg transition-all duration-300 hover:gap-3"
      >
        Ver todas las preguntas
        <ChevronRight class="w-5 h-5 group-hover:translate-x-0.5 transition-transform" />
      </a>
    </div>
  </div>
</section>
