---
import { MapPin, Phone, Mail, Clock } from 'lucide-astro';
import WhatsApp from './WhatsAppIcon.astro';
---

<section id="contacto" class="py-20 bg-gray-50 dark:bg-surface-dark-alt">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Contacta Conmigo
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Estoy aquí para ayudarte. Contacta conmigo para resolver tus dudas o reservar una consulta en Segovia.
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <!-- Contact Information Grid -->
      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <div class="bg-white dark:bg-surface-dark-elevated border border-gray-100 dark:border-slate-700 rounded-2xl shadow-sm p-8">
          <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6">
            Información de Contacto
          </h3>

          <div class="space-y-6">
            <div class="flex items-start space-x-4">
              <div class="flex items-center justify-center w-12 h-12 bg-primary-100 dark:bg-primary-900/30 rounded-full">
                <Phone class="w-6 h-6 text-primary-600 dark:text-primary-400" />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 dark:text-white">Teléfono</h4>
                <a href="tel:614417513" class="text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors" data-umami-event="phone-contact">
                  614 41 75 13
                </a>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="flex items-center justify-center w-12 h-12 bg-primary-100 dark:bg-primary-900/30 rounded-full">
                <Mail class="w-6 h-6 text-primary-600 dark:text-primary-400" />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 dark:text-white">Email</h4>
                <a href="mailto:alexandrapz.logopeda@gmail.com" class="text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors" data-umami-event="email-contact">
                  alexandrapz.logopeda@gmail.com
                </a>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="flex items-center justify-center w-12 h-12 bg-green-100 dark:bg-green-900/30 rounded-full">
                <MapPin class="w-6 h-6 text-green-600 dark:text-green-400" />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 dark:text-white">Ubicación</h4>
                <p class="text-gray-600 dark:text-gray-300">
                  Clínica Dra. Díaz Sastre<br />
                  Segovia, España
                </p>
              </div>
            </div>

            <div class="flex items-start space-x-4">
              <div class="flex items-center justify-center w-12 h-12 bg-orange-100 dark:bg-orange-900/30 rounded-full">
                <Clock class="w-6 h-6 text-orange-600 dark:text-orange-400" />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 dark:text-white">Horarios</h4>
                <div class="text-gray-600 dark:text-gray-300">
                  <p>Lunes y Jueves: 9:30 - 20:30</p>
                <p>Viernes: 10:00 - 14:00</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- WhatsApp Contact Card -->
        <div class="bg-green-50 dark:bg-green-900/20 border border-green-100 dark:border-green-800/30 rounded-2xl shadow-sm p-8">
          <div class="text-center">
            <div class="flex items-center justify-center w-20 h-20 bg-green-500 rounded-full mx-auto mb-6">
              <WhatsApp class="w-12 h-12 text-white" />
            </div>
            <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">
              Contacto Directo por WhatsApp
            </h3>
            <p class="text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
              La forma más rápida y cómoda de contactar conmigo. Te responderé lo antes posible para resolver tus dudas o programar tu cita.
            </p>

            <div class="space-y-4">
              <a
                href="https://wa.me/34614417513?text=Hola%20Alexandra,%20me%20gustaría%20reservar%20una%20consulta"
                target="_blank"
                rel="noopener noreferrer"
                data-umami-event="whatsapp-contact-reservar"
                class="block w-full bg-green-500 text-white px-8 py-4 rounded-full hover:bg-green-600 transition-all duration-300 font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-1"
              >
                Reservar Consulta
              </a>

              <a
                href="https://wa.me/34614417513?text=Hola%20Alexandra,%20tengo%20algunas%20preguntas%20sobre%20tus%20servicios"
                target="_blank"
                rel="noopener noreferrer"
                data-umami-event="whatsapp-contact-consulta"
                class="block w-full border-2 border-green-500 text-green-600 dark:text-green-400 px-8 py-4 rounded-full hover:bg-green-500 hover:text-white transition-all duration-300 font-semibold"
              >
                Hacer Consulta
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Map Section -->
      <div class="mt-8 bg-white dark:bg-surface-dark-elevated border border-gray-100 dark:border-slate-700 rounded-2xl shadow-sm overflow-hidden">
        <div class="p-6 border-b border-gray-100 dark:border-slate-700">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 bg-primary-600 rounded-full flex items-center justify-center">
              <MapPin class="w-5 h-5 text-white" />
            </div>
            <div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white">Nuestra Ubicación</h3>
              <p class="text-gray-600 dark:text-gray-400 text-sm">Clínica Dra. Díaz Sastre, Segovia</p>
            </div>
          </div>
        </div>
        <div class="relative w-full h-80">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d24258.53850673086!2d-4.138870699999999!3d40.9429413!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd413eb9b3ddf53d%3A0x35e5ee4b9e1eb6!2sSegovia%2C%20Spain!5e0!3m2!1sen!2sus!4v1704300000000!5m2!1sen!2sus"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación de la clínica en Segovia"
            class="absolute inset-0"
          ></iframe>
        </div>
        <div class="p-4 bg-primary-50 dark:bg-surface-dark">
          <a
            href="https://www.google.com/maps/search/Clinica+Dra+Diaz+Sastre+Segovia"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-medium transition-colors"
          >
            <MapPin class="w-4 h-4 mr-2" />
            Ver en Google Maps
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
