---
import Layout from "./Layout.astro";
import Header from "@/components/HeaderWithNavigation.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import WhatsApp from "@/components/WhatsAppIcon.astro";
import { Phone, CheckCircle, AlertCircle, ArrowRight } from "lucide-astro";
import type { Service } from "@/data/services";
import { services } from "@/data/services";

interface Props {
  service: Service;
}

const { service } = Astro.props;

const relatedServiceData = service.relatedServices
  .map((slug) => services.find((s) => s.slug === slug))
  .filter(Boolean) as Service[];

const breadcrumbs = [
  { label: "Inicio", href: "/" },
  { label: "Terapias", href: "/#terapias" },
  { label: service.title },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.shortDescription,
  provider: {
    "@type": "Person",
    name: "Alexandra Palacios",
    jobTitle: "Logopeda Especialista",
    url: "https://alexandrapalacios.com",
  },
  areaServed: {
    "@type": "Place",
    name: "Segovia, España",
  },
  serviceType: "Logopedia",
  url: `https://alexandrapalacios.com/${service.slug}`,
};
---

<Layout title={service.metaTitle} description={service.metaDescription}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(serviceSchema)}
  />

  <Header />

  <main class="pt-20">
    <!-- Hero -->
    <section
      class="relative bg-primary-50 dark:bg-surface-dark py-16 md:py-24 px-4 sm:px-6 lg:px-8 overflow-hidden"
    >
      <div class="absolute inset-0 -z-10">
        <div
          class="absolute top-0 -left-4 w-72 h-72 bg-primary-300/30 dark:bg-primary-700/20 rounded-full mix-blend-multiply dark:mix-blend-normal filter blur-xl opacity-70 animate-blob"
        ></div>
        <div
          class="absolute top-0 -right-4 w-72 h-72 bg-primary-200/30 dark:bg-primary-800/20 rounded-full mix-blend-multiply dark:mix-blend-normal filter blur-xl opacity-70 animate-blob [animation-delay:2s]"
        ></div>
      </div>

      <div class="max-w-4xl mx-auto relative" data-reveal="animate-fade-in animate-duration-500">
        <div class="mb-6">
          <Breadcrumbs items={breadcrumbs} />
        </div>
        <h1
          class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6 leading-tight"
        >
          {service.title}
          <span class="block text-2xl md:text-3xl font-normal text-primary-600 dark:text-primary-400 mt-2">
            en Segovia
          </span>
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 leading-relaxed max-w-3xl">
          {service.shortDescription}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a
            href={`https://wa.me/34614417513?text=Hola%20Alexandra,%20me%20interesa%20la%20${encodeURIComponent(service.title)}`}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event={`whatsapp-service-page-${service.slug}`}
            class="inline-flex items-center justify-center px-8 py-4 bg-primary-600 text-white font-semibold rounded-full hover:bg-primary-700 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
          >
            Pedir Cita
          </a>
          <a
            href="tel:614417513"
            data-umami-event={`phone-service-page-${service.slug}`}
            class="inline-flex items-center justify-center px-8 py-4 border-2 border-primary-600 dark:border-primary-400 text-primary-600 dark:text-primary-400 font-semibold rounded-full hover:bg-primary-600 hover:text-white dark:hover:bg-primary-400 dark:hover:text-surface-dark transition-all duration-300 transform hover:-translate-y-0.5"
          >
            <Phone class="w-5 h-5 mr-2" />
            614 41 75 13
          </a>
        </div>
      </div>
    </section>

    <!-- Full Description -->
    <section class="py-16 bg-white dark:bg-surface-dark">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 prose prose-lg service-content">
        <Fragment set:html={service.fullDescription} />
      </div>
    </section>

    <!-- Symptoms -->
    <section class="py-16 bg-gray-50 dark:bg-surface-dark-alt">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8 flex items-center gap-3">
          <AlertCircle class="w-8 h-8 text-primary-600 dark:text-primary-400" />
          ¿Cuándo acudir a consulta?
        </h2>
        <div class="grid md:grid-cols-2 gap-4" data-reveal="animate-fade-in animate-slide-in-from-bottom-4 animate-duration-500">
          {service.symptoms.map((symptom) => (
            <div class="flex items-start gap-3 bg-white dark:bg-surface-dark-elevated border border-gray-100 dark:border-slate-700 p-4 rounded-xl shadow-sm">
              <div class="w-2 h-2 bg-primary-600 dark:bg-primary-400 rounded-full mt-2.5 flex-shrink-0" />
              <span class="text-gray-700 dark:text-gray-300">{symptom}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Treatment Process -->
    <section class="py-16 bg-white dark:bg-surface-dark">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">
          Proceso de tratamiento
        </h2>
        <div class="space-y-4" data-reveal="animate-fade-in animate-duration-500">
          {service.treatmentProcess.map((step, index) => (
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-primary-600 rounded-full flex items-center justify-center flex-shrink-0">
                <span class="text-white font-bold text-sm">{index + 1}</span>
              </div>
              <div class="pt-2">
                <p class="text-gray-700 dark:text-gray-300 leading-relaxed">{step}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section class="py-16 bg-primary-50 dark:bg-surface-dark-alt">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">
          Beneficios del tratamiento
        </h2>
        <div class="grid md:grid-cols-2 gap-4" data-reveal="animate-fade-in animate-slide-in-from-bottom-4 animate-duration-500">
          {service.benefits.map((benefit) => (
            <div class="flex items-start gap-3">
              <CheckCircle class="w-6 h-6 text-green-500 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700 dark:text-gray-300">{benefit}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    {service.faq.length > 0 && (
      <section class="py-16 bg-white dark:bg-surface-dark">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
          <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">
            Preguntas frecuentes sobre {service.title.toLowerCase()}
          </h2>
          <div class="space-y-4">
            {service.faq.map((item) => (
              <details class="group bg-gray-50 dark:bg-surface-dark-alt border border-gray-100 dark:border-slate-700 rounded-xl overflow-hidden">
                <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-gray-900 dark:text-white hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                  {item.question}
                  <span class="ml-4 text-primary-600 dark:text-primary-400 group-open:rotate-180 transition-transform">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <div class="px-6 pb-6 text-gray-600 dark:text-gray-300 leading-relaxed">
                  {item.answer}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="py-16 bg-primary-700 dark:bg-primary-900">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">
          ¿Necesitas {service.title.toLowerCase()}?
        </h2>
        <p class="text-xl text-primary-100 mb-4">
          {service.priceReference}
        </p>
        <p class="text-primary-100 mb-8 max-w-2xl mx-auto">
          Contacta conmigo para una valoración personalizada. Te explicaré el tratamiento y resolveré todas tus dudas.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={`https://wa.me/34614417513?text=Hola%20Alexandra,%20me%20interesa%20la%20${encodeURIComponent(service.title)}`}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event={`whatsapp-service-cta-${service.slug}`}
            class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary-700 font-semibold rounded-full hover:bg-gray-100 transition-all duration-300 shadow-lg transform hover:-translate-y-0.5"
          >
            <WhatsApp class="w-5 h-5 mr-2" />
            Contactar por WhatsApp
          </a>
          <a
            href="tel:614417513"
            data-umami-event={`phone-service-cta-${service.slug}`}
            class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-full hover:bg-white hover:text-primary-700 transition-all duration-300 transform hover:-translate-y-0.5"
          >
            <Phone class="w-5 h-5 mr-2" />
            Llamar: 614 41 75 13
          </a>
        </div>
      </div>
    </section>

    <!-- Related Services -->
    {relatedServiceData.length > 0 && (
      <section class="py-16 bg-gray-50 dark:bg-surface-dark-alt">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
          <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">
            Terapias relacionadas
          </h2>
          <div class="grid md:grid-cols-3 gap-6" data-reveal="animate-fade-in animate-slide-in-from-bottom-4 animate-duration-500">
            {relatedServiceData.map((related) => (
              <a
                href={`/${related.slug}/`}
                class="bg-white dark:bg-surface-dark-elevated border border-gray-100 dark:border-slate-700 hover:border-primary-200 dark:hover:border-primary-800 rounded-2xl p-6 shadow-sm hover:shadow-lg transition-all duration-300 group"
              >
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                  {related.title}
                </h3>
                <p class="text-gray-600 dark:text-gray-300 text-sm mb-4 line-clamp-3">
                  {related.shortDescription}
                </p>
                <span class="inline-flex items-center text-primary-600 dark:text-primary-400 font-medium text-sm group-hover:gap-2 transition-all">
                  Saber más
                  <ArrowRight class="w-4 h-4 ml-1" />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>

<style>
  .service-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    color: #111827;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .service-content :global(p) {
    color: #4b5563;
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .service-content :global(a) {
    color: #0d9488;
    text-decoration: underline;
  }
  .service-content :global(strong) {
    color: #111827;
  }

  :global(.dark) .service-content :global(h2) {
    color: #fff;
  }
  :global(.dark) .service-content :global(p) {
    color: #d1d5db;
  }
  :global(.dark) .service-content :global(a) {
    color: #2dd4bf;
  }
  :global(.dark) .service-content :global(strong) {
    color: #fff;
  }
</style>
