---
import Layout from "./Layout.astro";
import Header from "@/components/HeaderWithNavigation.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import WhatsApp from "@/components/WhatsAppIcon.astro";
import { Phone, CheckCircle, AlertCircle, ArrowRight } from "lucide-astro";
import type { Service } from "@/data/services";
import { services } from "@/data/services";

interface Props {
  service: Service;
}

const { service } = Astro.props;

const relatedServiceData = service.relatedServices
  .map((slug) => services.find((s) => s.slug === slug))
  .filter(Boolean) as Service[];

const breadcrumbs = [
  { label: "Inicio", href: "/" },
  { label: "Terapias", href: "/#terapias" },
  { label: service.title },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.shortDescription,
  provider: {
    "@type": "Person",
    name: "Alexandra Palacios",
    jobTitle: "Logopeda Especialista",
    url: "https://alexandrapalacios.com",
  },
  areaServed: {
    "@type": "Place",
    name: "Segovia, España",
  },
  serviceType: "Logopedia",
  url: `https://alexandrapalacios.com/${service.slug}`,
};
---

<Layout title={service.metaTitle} description={service.metaDescription}>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(serviceSchema)}
  />

  <Header />

  <main class="pt-20">
    <!-- Hero -->
    <section
      class="relative bg-gradient-to-br from-purple-50 via-white to-blue-50 py-16 md:py-24 px-4 overflow-hidden"
    >
      <div
        class="absolute inset-0 -z-10"
      >
        <div
          class="absolute top-0 -left-4 w-72 h-72 bg-purple-300 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob"
        >
        </div>
        <div
          class="absolute top-0 -right-4 w-72 h-72 bg-blue-300 rounded-full mix-blend-multiply filter blur-xl opacity-70 animate-blob [animation-delay:2s]"
        >
        </div>
      </div>

      <div class="max-w-4xl mx-auto relative">
        <div class="mb-6">
          <Breadcrumbs items={breadcrumbs} />
        </div>
        <h1
          class="text-4xl md:text-5xl font-bold text-gray-900 mb-6 leading-tight"
        >
          {service.title}
          <span class="block text-2xl md:text-3xl font-normal text-purple-600 mt-2">
            en Segovia
          </span>
        </h1>
        <p class="text-xl text-gray-600 leading-relaxed max-w-3xl">
          {service.shortDescription}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a
            href={`https://wa.me/34614417513?text=Hola%20Alexandra,%20me%20interesa%20la%20${encodeURIComponent(service.title)}`}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event={`whatsapp-service-page-${service.slug}`}
            class="inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-purple-600 to-blue-600 text-white font-semibold rounded-full hover:from-purple-700 hover:to-blue-700 transition-all duration-300 shadow-lg hover:shadow-xl"
          >
            Pedir Cita
          </a>
          <a
            href="tel:614417513"
            data-umami-event={`phone-service-page-${service.slug}`}
            class="inline-flex items-center justify-center px-8 py-4 border-2 border-purple-600 text-purple-600 font-semibold rounded-full hover:bg-purple-600 hover:text-white transition-all duration-300"
          >
            <Phone class="w-5 h-5 mr-2" />
            614 41 75 13
          </a>
        </div>
      </div>
    </section>

    <!-- Full Description -->
    <section class="py-16 bg-white">
      <div
        class="max-w-4xl mx-auto px-4 prose prose-lg prose-purple max-w-none [&>h2]:text-2xl [&>h2]:font-bold [&>h2]:text-gray-900 [&>h2]:mt-10 [&>h2]:mb-4 [&>p]:text-gray-600 [&>p]:leading-relaxed [&>p]:mb-4"
      >
        <Fragment set:html={service.fullDescription} />
      </div>
    </section>

    <!-- Symptoms -->
    <section class="py-16 bg-gray-50">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center gap-3">
          <AlertCircle class="w-8 h-8 text-purple-600" />
          ¿Cuándo acudir a consulta?
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          {service.symptoms.map((symptom) => (
            <div class="flex items-start gap-3 bg-white p-4 rounded-xl shadow-sm">
              <div class="w-2 h-2 bg-purple-600 rounded-full mt-2.5 flex-shrink-0" />
              <span class="text-gray-700">{symptom}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Treatment Process -->
    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">
          Proceso de tratamiento
        </h2>
        <div class="space-y-4">
          {service.treatmentProcess.map((step, index) => (
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-gradient-to-br from-purple-600 to-blue-600 rounded-full flex items-center justify-center flex-shrink-0">
                <span class="text-white font-bold text-sm">{index + 1}</span>
              </div>
              <div class="pt-2">
                <p class="text-gray-700 leading-relaxed">{step}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Benefits -->
    <section class="py-16 bg-gradient-to-br from-purple-50 to-blue-50">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">
          Beneficios del tratamiento
        </h2>
        <div class="grid md:grid-cols-2 gap-4">
          {service.benefits.map((benefit) => (
            <div class="flex items-start gap-3">
              <CheckCircle class="w-6 h-6 text-green-500 mt-0.5 flex-shrink-0" />
              <span class="text-gray-700">{benefit}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    {service.faq.length > 0 && (
      <section class="py-16 bg-white">
        <div class="max-w-4xl mx-auto px-4">
          <h2 class="text-3xl font-bold text-gray-900 mb-8">
            Preguntas frecuentes sobre {service.title.toLowerCase()}
          </h2>
          <div class="space-y-4">
            {service.faq.map((item) => (
              <details class="group bg-gray-50 rounded-xl overflow-hidden">
                <summary class="flex items-center justify-between cursor-pointer p-6 font-semibold text-gray-900 hover:text-purple-600 transition-colors">
                  {item.question}
                  <span class="ml-4 text-purple-600 group-open:rotate-180 transition-transform">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <div class="px-6 pb-6 text-gray-600 leading-relaxed">
                  {item.answer}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="py-16 bg-gradient-to-r from-purple-600 to-blue-600">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">
          ¿Necesitas {service.title.toLowerCase()}?
        </h2>
        <p class="text-xl text-purple-100 mb-4">
          {service.priceReference}
        </p>
        <p class="text-purple-100 mb-8 max-w-2xl mx-auto">
          Contacta conmigo para una valoración personalizada. Te explicaré el tratamiento y resolveré todas tus dudas.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={`https://wa.me/34614417513?text=Hola%20Alexandra,%20me%20interesa%20la%20${encodeURIComponent(service.title)}`}
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event={`whatsapp-service-cta-${service.slug}`}
            class="inline-flex items-center justify-center px-8 py-4 bg-white text-purple-600 font-semibold rounded-full hover:bg-gray-100 transition-all duration-300 shadow-lg"
          >
            <WhatsApp class="w-5 h-5 mr-2" />
            Contactar por WhatsApp
          </a>
          <a
            href="tel:614417513"
            data-umami-event={`phone-service-cta-${service.slug}`}
            class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-semibold rounded-full hover:bg-white hover:text-purple-600 transition-all duration-300"
          >
            <Phone class="w-5 h-5 mr-2" />
            Llamar: 614 41 75 13
          </a>
        </div>
      </div>
    </section>

    <!-- Related Services -->
    {relatedServiceData.length > 0 && (
      <section class="py-16 bg-gray-50">
        <div class="max-w-4xl mx-auto px-4">
          <h2 class="text-3xl font-bold text-gray-900 mb-8">
            Terapias relacionadas
          </h2>
          <div class="grid md:grid-cols-3 gap-6">
            {relatedServiceData.map((related) => (
              <a
                href={`/${related.slug}`}
                class="bg-white rounded-2xl p-6 shadow-md hover:shadow-lg transition-all duration-300 group"
              >
                <h3 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-purple-600 transition-colors">
                  {related.title}
                </h3>
                <p class="text-gray-600 text-sm mb-4 line-clamp-3">
                  {related.shortDescription}
                </p>
                <span class="inline-flex items-center text-purple-600 font-medium text-sm group-hover:gap-2 transition-all">
                  Saber más
                  <ArrowRight class="w-4 h-4 ml-1" />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>
