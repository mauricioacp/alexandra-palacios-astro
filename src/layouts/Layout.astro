---
import "../styles/global.css";
import { services } from "@/data/services";

export interface Props {
  title: string;
  description: string;
  image?: string;
  noIndex?: boolean;
}

const {
  title,
  description,
  image = "/og-image.jpg",
  noIndex = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const siteOrigin = "https://alexandrapalacios.com";

const businessSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "@id": `${siteOrigin}/#business`,
  name: "Alexandra Palacios - Logopeda Especialista",
  description:
    "Logopeda especialista en terapia miofuncional y rehabilitación del habla en Segovia. Más de 17 años de experiencia clínica.",
  url: siteOrigin,
  logo: `${siteOrigin}/og-image.jpg`,
  image: `${siteOrigin}/og-image.jpg`,
  telephone: "+34614417513",
  email: "alexandrapz.logopeda@gmail.com",
  priceRange: "€€",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Segovia",
    addressRegion: "Castilla y León",
    addressCountry: "ES",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 40.9429,
    longitude: -4.1088,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Thursday"],
      opens: "09:30",
      closes: "20:30",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Friday"],
      opens: "10:00",
      closes: "14:00",
    },
  ],
  areaServed: {
    "@type": "City",
    name: "Segovia",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios de logopedia",
    itemListElement: services.map((service) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "MedicalTherapy",
        name: service.title,
        url: `${siteOrigin}/${service.slug}/`,
      },
    })),
  },
  founder: {
    "@type": "Person",
    "@id": `${siteOrigin}/#person`,
  },
  sameAs: [
    "https://wa.me/34614417513",
    "https://share.google/u0xYr6WKjBmDf4VEQ",
  ],
};

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${siteOrigin}/#person`,
  name: "Alexandra Palacios",
  jobTitle: "Logopeda Especialista",
  description:
    "Logopeda con más de 17 años de experiencia clínica, especializada en terapia miofuncional y rehabilitación del habla.",
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universidad Complutense de Madrid",
  },
  knowsAbout: [
    "Logopedia",
    "Terapia Miofuncional",
    "Rehabilitación del Habla",
    "Disfagia",
    "Deglución Infantil",
    "Entrenamiento Vocal",
    "Programación Neurolingüística (PNL)",
  ],
  worksFor: {
    "@type": "MedicalBusiness",
    "@id": `${siteOrigin}/#business`,
  },
  url: siteOrigin,
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#faf5ff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="logopeda Segovia, terapia miofuncional, rehabilitación habla, deglución infantil, disfagia adulta, entrenamiento vocal, Alexandra Palacios"
    />
    <meta name="author" content="Alexandra Palacios" />
    <meta name="language" content="Spanish" />
    <meta name="geo.region" content="ES-SG" />
    <meta name="geo.placename" content="Segovia" />
    <meta name="ICBM" content="40.9429, -4.1088" />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta
      property="og:site_name"
      content="Alexandra Palacios - Logopeda Especialista"
    />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Google Site Verification -->
    <meta name="google-site-verification" content="g13FTWS_bpUn62bJtWiqKycCZl3FaVeKcpTpUI5AfF0" />

    <!-- Preconnect hints for faster loading -->
    <link rel="preconnect" href="https://umami-mc.laakademia.app" />
    <link rel="dns-prefetch" href="https://www.google.com" />
    <link rel="dns-prefetch" href="https://maps.googleapis.com" />

    <!-- Structured Data: MedicalBusiness -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(businessSchema)} />

    <!-- Structured Data: Person -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />

    <!-- FOUC prevention: apply dark class before paint -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <script defer src="https://umami-mc.laakademia.app/script.js" data-website-id="9c1b4fb8-fd7f-4369-a58c-227fc5049eed" is:inline></script>
  </head>
  <body>
    <slot />

    <!-- Scroll-triggered reveal animations -->
    <script>
      function initScrollReveal() {
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) return;

        const revealElements = document.querySelectorAll('[data-reveal]');
        revealElements.forEach(el => {
          (el as HTMLElement).style.opacity = '0';
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                el.style.opacity = '';
                const classes = el.dataset.reveal?.split(' ') || [];
                el.classList.add(...classes);
                observer.unobserve(el);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
        );

        revealElements.forEach(el => observer.observe(el));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveal);
      } else {
        initScrollReveal();
      }

      document.addEventListener('astro:page-load', initScrollReveal);
    </script>
  </body>
</html>
