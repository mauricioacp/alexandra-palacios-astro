---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/HeaderWithNavigation.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const breadcrumbs = [
  { label: "Inicio", href: "/" },
  { label: "Blog" },
];
---

<Layout
  title="Blog de Logopedia | Alexandra Palacios - Logopeda Segovia"
  description="Artículos sobre logopedia, terapia miofuncional, disfagia, deglución infantil y más. Consejos profesionales de Alexandra Palacios, logopeda en Segovia."
>
  <Header />

  <main class="pt-20">
    <section class="bg-gradient-to-br from-purple-50 via-white to-blue-50 py-16 px-4">
      <div class="max-w-4xl mx-auto">
        <div class="mb-6">
          <Breadcrumbs items={breadcrumbs} />
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          Blog de Logopedia
        </h1>
        <p class="text-xl text-gray-600 max-w-2xl">
          Artículos y consejos profesionales sobre logopedia, terapia miofuncional y rehabilitación del habla.
        </p>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-8">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id.replace(/\.md$/, "")}`}
              class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 overflow-hidden"
            >
              <div class="p-6">
                <div class="flex items-center gap-3 mb-3">
                  <span class="inline-block px-3 py-1 bg-purple-100 text-purple-700 text-xs font-medium rounded-full">
                    {post.data.category}
                  </span>
                  <time class="text-xs text-gray-400" datetime={post.data.date.toISOString()}>
                    {post.data.date.toLocaleDateString("es-ES", { year: "numeric", month: "short", day: "numeric" })}
                  </time>
                </div>
                <h2 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-purple-600 transition-colors">
                  {post.data.title}
                </h2>
                <p class="text-gray-600 text-sm line-clamp-3">
                  {post.data.description}
                </p>
                <span class="inline-flex items-center text-purple-600 font-medium text-sm mt-4 group-hover:gap-2 transition-all">
                  Leer artículo
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
