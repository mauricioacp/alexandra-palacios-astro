---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/HeaderWithNavigation.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="Página no encontrada - Alexandra Palacios Logopeda"
  description="La página que buscas no existe. Vuelve al inicio o contacta con Alexandra Palacios, logopeda en Segovia."
  noIndex={true}
>
  <Header />

  <main class="pt-20">
    <section class="min-h-[60vh] flex items-center justify-center bg-primary-50 dark:bg-surface-dark px-4">
      <div class="text-center max-w-lg">
        <div class="text-8xl font-bold text-primary-200 dark:text-primary-800 mb-4">404</div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
          Página no encontrada
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300 mb-8">
          Lo siento, la página que buscas no existe o ha sido movida.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/"
            class="inline-flex items-center justify-center px-8 py-3 bg-primary-600 text-white font-semibold rounded-full hover:bg-primary-700 transition-all duration-300 shadow-lg"
          >
            Volver al inicio
          </a>
          <a
            href="https://wa.me/34614417513?text=Hola%20Alexandra,%20tengo%20una%20pregunta"
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="whatsapp-404"
            class="inline-flex items-center justify-center px-8 py-3 border-2 border-primary-600 dark:border-primary-400 text-primary-600 dark:text-primary-400 font-semibold rounded-full hover:bg-primary-600 hover:text-white dark:hover:bg-primary-400 dark:hover:text-surface-dark transition-all duration-300"
          >
            Contactar por WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
