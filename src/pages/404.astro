---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/HeaderWithNavigation.astro";
import Footer from "@/components/Footer.astro";
import { services } from "@/data/services";
---

<Layout
  title="Página no encontrada - Alexandra Palacios Logopeda"
  description="La página que buscas no existe. Vuelve al inicio o explora las terapias disponibles con Alexandra Palacios, logopeda en Segovia."
  noIndex={true}
>
  <Header />

  <main class="pt-20">
    <section class="py-16 bg-primary-50 dark:bg-surface-dark px-4">
      <div class="max-w-3xl mx-auto text-center">
        <div class="text-8xl font-bold text-primary-200 dark:text-primary-800 mb-4">404</div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
          Página no encontrada
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300 mb-8">
          Lo siento, la página que buscas no existe o ha sido movida.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/"
            class="inline-flex items-center justify-center px-8 py-3 bg-primary-600 text-white font-semibold rounded-full hover:bg-primary-700 transition-all duration-300 shadow-lg"
          >
            Volver al inicio
          </a>
          <a
            href="https://wa.me/34614417513?text=Hola%20Alexandra,%20tengo%20una%20pregunta"
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="whatsapp-404"
            class="inline-flex items-center justify-center px-8 py-3 border-2 border-primary-600 dark:border-primary-400 text-primary-600 dark:text-primary-400 font-semibold rounded-full hover:bg-primary-600 hover:text-white dark:hover:bg-primary-400 dark:hover:text-surface-dark transition-all duration-300"
          >
            Contactar por WhatsApp
          </a>
        </div>
      </div>
    </section>

    <section class="py-16 bg-white dark:bg-surface-dark-alt px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white text-center mb-2">
          Quizá te interese alguna de estas terapias
        </h2>
        <p class="text-center text-gray-600 dark:text-gray-400 mb-10">
          Explora las áreas de especialización de la consulta.
        </p>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {services.map((service) => (
            <li>
              <a
                href={`/${service.slug}/`}
                data-umami-event={`404-to-service-${service.slug}`}
                class="block h-full p-6 rounded-2xl bg-primary-50 dark:bg-surface-dark-elevated ring-1 ring-primary-100 dark:ring-primary-500/20 hover:ring-primary-400 dark:hover:ring-primary-400 hover:-translate-y-0.5 transition-all duration-200"
              >
                <h3 class="text-lg font-semibold text-primary-700 dark:text-primary-300 mb-2">
                  {service.title}
                </h3>
                <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                  {service.shortDescription}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
